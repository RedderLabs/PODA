# Cabeceras para Cloudflare Pages (otros alojamientos ignoran este archivo; ver docs/desarrollo.md).
# WebUSB solo para esta web, y nunca dentro de un marco de otra página.
/*
  Permissions-Policy: usb=(self), camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Los archivos de _next/static llevan una huella en el nombre: no cambian nunca.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
